[Unit]
Description=RF Conecta (gunicorn)
After=network.target

[Service]
User=rf
Group=rf
WorkingDirectory=/opt/rfconecta
EnvironmentFile=/etc/rfconecta.env
ExecStart=/opt/rfconecta/.venv/bin/gunicorn app:app --bind 127.0.0.1:8000 --workers 2 --threads 4 --timeout 30
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
